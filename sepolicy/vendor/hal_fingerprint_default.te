type vendor_hal_fingerprint_hwservice_xiaomi, hwservice_manager_type;

allow hal_fingerprint_default sysfs_goodix_touch:dir r_dir_perms;
allow hal_fingerprint_default sysfs_goodix_touch:file rw_file_perms;
allow hal_fingerprint_default self:capability { sys_nice };
allow hal_fingerprint_default tee_device:chr_file rw_file_perms;
allow hal_fingerprint_default touchfeature_device:chr_file rw_file_perms;
allow hal_fingerprint_default vendor_dmabuf_qseecom_heap_device:chr_file r_file_perms;
allow hal_fingerprint_default vendor_dmabuf_qseecom_ta_heap_device:chr_file r_file_perms;
allow hal_fingerprint_default vendor_fingerprint_data_file:dir r_dir_perms;
allow hal_fingerprint_default vendor_fingerprint_data_file:file create_file_perms;
allow hal_fingerprint_default vendor_fingerprint_device:chr_file rwx_file_perms;
allow hal_fingerprint_default vendor_hal_perf_default:binder call;
allow vendor_hal_perf_default hal_fingerprint_default:file read;
allow hal_fingerprint_default vendor_hal_perf_hwservice:hwservice_manager find;
allow hal_fingerprint_default vendor_sp_keymaster_device:chr_file rw_file_perms;
allow hal_fingerprint_default vendor_sysfs_displayfeature:dir r_dir_perms;
allow hal_fingerprint_default vendor_sysfs_displayfeature:file rw_file_perms;
allow vendor_hal_perf_default hal_fingerprint_default:dir { search read write };
allow vendor_hal_perf_default hal_fingerprint_default:file { read write open getattr };
allow hal_fingerprint_default vendor_sysfs_sensors:file rw_file_perms;
allow hal_fingerprint_default self:netlink_socket create_socket_perms_no_ioctl;
add_hwservice(hal_fingerprint_default, vendor_hal_fingerprint_hwservice_xiaomi)
get_prop(hal_fingerprint_default, vendor_fp_prop)
get_prop(hal_fingerprint_default, vendor_camera_prop)
get_prop(hal_fingerprint_default, vendor_spcomlib_prop)
get_prop(hal_fingerprint_default, vendor_tee_listener_prop)
set_prop(hal_fingerprint_default, vendor_fp_prop)
r_dir_file(hal_fingerprint_default, firmware_file)
r_dir_file(hal_fingerprint_default, mnt_vendor_file)
r_dir_file(hal_fingerprint_default, vendor_persist_qti_fp_file)

allow hal_fingerprint_default vendor_displayfeature_device:chr_file { ioctl open read write };

allow hal_fingerprint_default vendor_camera_prop:file { read map };
allow hal_fingerprint_default self:capability sys_nice;
allow vendor_hal_usb_qti sysfs_udc:dir search;