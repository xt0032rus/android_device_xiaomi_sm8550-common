# The camera property contexts (persist.vendor.EnableP3ColorSpace and
# vendor.camera.sensor.*) are declared in
# device/xiaomi/fuxi-miuicamera/sepolicy/vendor/property_contexts.
# Declaring them here as well triggers
#   "Unable to serialize property contexts: Duplicate prefix match detected"
# from property_info_checker, so keep them out of this file.

# Fingerprint
persist.vendor.fingerprint. u:object_r:vendor_fp_prop:s0
persist.vendor.sys.fp. u:object_r:vendor_fp_prop:s0
ro.hardware.fp.udfps u:object_r:vendor_fp_prop:s0

# Thermal
vendor.sys.thermal.data.path u:object_r:vendor_thermal_normal_prop:s0

# Mlipay
persist.vendor.sys.pay.ifaa u:object_r:vendor_payment_security_prop:s0

# NFC
ro.vendor.nfc. u:object_r:vendor_nfc_mi_prop:s0
ro.vendor.se. u:object_r:vendor_nfc_mi_prop:s0

ro.vendor.oem.                        u:object_r:vendor_oem_prop:s0
vendor.sys.thermal.bcl.               u:object_r:vendor_thermal_bcl_prop:s0
