# Dalvik
dalvik.vm.heapsize=36m
dalvik.vm.dex2oat64.enabled=true
dev.pm.dyn_samplingrate=1

# Graphics
ro.opengles.version=196610

# HWUI
ro.hwui.texture_cache_size=72
ro.hwui.layer_cache_size=48
ro.hwui.r_buffer_cache_size=8
ro.hwui.path_cache_size=32
ro.hwui.gradient_cache_size=1
ro.hwui.drop_shadow_cache_size=6
ro.hwui.texture_cache_flushrate=0.4
ro.hwui.text_small_cache_width=1024
ro.hwui.text_small_cache_height=1024
ro.hwui.text_large_cache_width=2048
ro.hwui.text_large_cache_height=1024
debug.hwui.skia_atrace_enabled=false

# IMS
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
persist.data.df.iwlan_mux=9
ro.vendor.use_data_netmgrd=true

# Media
media.settings.xml=/odm/etc/media_profiles_kalama.xml

# QEMU
qemu.hw.mainkeys=0

# Radio VoNR Calling
persist.radio.is_vonr_enabled_0=true
persist.radio.is_vonr_enabled_1=true
persist.vendor.vonr_setting_support=1

# RIL
rild.libpath=/vendor/lib64/libril-qc-hal-qmi.so
ril.subscription.types=NV,RUIM
ro.telephony.default_network=33,33

ro.gms.ads.disable=true
persist.gms.ads.dsid.enable=false

# keystore
ro.hardware.keystore_disable=true
ro.security.keystore.enforce_timeout=false

# IPC
persist.vendor.mink.ipc.keepalive=30000

# Network timeouts to prevent infinite retry loops
net.tcp.timeout.connect=10000
net.tcp.timeout.read=30000
net.tcp.timeout.write=30000
net.dns.timeout=10000